# Salin file ini menjadi .env lalu isi nilainya.
# Jangan pernah commit file .env ke Git.

# Wajib: kunci penandatanganan JWT (gunakan string acak yang panjang)
SECRET_KEY=ganti_dengan_string_rahasia_yang_panjang

# PIN dashboard pemilik (hanya dicek di backend)
OWNER_PIN=123456

# Masa berlaku token owner (jam)
JWT_EXPIRE_HOURS=12

# Midtrans Snap (sandbox). Kosongkan jika hanya uji pembayaran tunai.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Origin frontend yang diizinkan. Gunakan * untuk development lokal.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
