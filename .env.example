# ============================================================
# Dimsum Gembul POS — Contoh variabel lingkungan
# ============================================================
# Salin file ini ke lokasi yang sesuai:
#   cp .env.example backend/.env
#   cp .env.example frontend/.env
#
# JANGAN commit file .env yang berisi nilai/credentials asli.
# File ini hanya berisi placeholder — ISI dengan nilai nyata.
# ============================================================

# --- Backend (backend/.env) ---
SECRET_KEY=ganti_dengan_string_acak_panjang_minimal_32_karakter
OWNER_PIN=123456
JWT_EXPIRE_HOURS=12

# RBAC — Password default untuk seed 3 akun (owner, kasir, staff_hpp)
# Dipakai sekali saat: python seed.py
# Segera ganti password semua akun setelah seed selesai!
DEFAULT_ADMIN_PASSWORD=GantiSegera!2025

# Midtrans — kosongkan untuk mode dev tanpa QRIS
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# CORS — pisahkan dengan koma jika lebih dari satu origin
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- WhatsApp Bot (backend/.env) ---
GEMINI_API_KEY=isi_api_key_gemini_anda_dari_aistudio_google_com
KASIR_API_URL=http://127.0.0.1:8000
BOT_HOST=127.0.0.1
BOT_PORT=8001

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
